{
  "name": "industriesalon/wp-tooling",
  "type": "project",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpstan/phpstan": "^1.12",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "lint:php": "bash tools/phpcs-target.sh",
    "lint:php:all": "phpcs --report=summary",
    "lint:phpstan": "bash tools/phpstan-target.sh",
    "lint:phpstan:all": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
