{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1720px",
      "wideSize": "1720px"
    },
    "spacing": {
      "blockGap": "1.35rem",
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "name": "XS",
          "slug": "xs",
          "size": "0.35rem"
        },
        {
          "name": "S",
          "slug": "s",
          "size": "0.5rem"
        },
        {
          "name": "M",
          "slug": "m",
          "size": "0.75rem"
        },
        {
          "name": "L",
          "slug": "l",
          "size": "1rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "1.5rem"
        },
        {
          "name": "2XL",
          "slug": "2xl",
          "size": "2.5rem"
        },
        {
          "name": "3XL",
          "slug": "3xl",
          "size": "3.5rem"
        },
        {
          "name": "4XL",
          "slug": "4xl",
          "size": "5rem"
        }
      ]
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "palette": [
        {
          "name": "Scarlet Red",
          "slug": "scarlet-red",
          "color": "#e81d25"
        },
        {
          "name": "Vaporous White",
          "slug": "vaporous-white",
          "color": "#f9f9fa"
        },
        {
          "name": "Eerie Black",
          "slug": "eerie-black",
          "color": "#1e1e1e"
        },
        {
          "name": "Cerebral Grey",
          "slug": "cerebral-grey",
          "color": "#c0b8b5"
        },
        {
          "name": "Turtle Green",
          "slug": "turtle-green",
          "color": "#579e7d"
        },
        {
          "name": "Pale Rock Blue",
          "slug": "pale-rock-blue",
          "color": "#869fba"
        },
        {
          "name": "Sunrise Yellow",
          "slug": "sunrise-yellow",
          "color": "#ebbc1e"
        },
        {
          "name": "Russet Brown",
          "slug": "russet-brown",
          "color": "#753a18"
        }
      ],
      "gradients": []
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "name": "IBM Plex Sans",
          "slug": "plex",
          "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.125rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "1.375rem"
        },
        {
          "name": "2XL",
          "slug": "2xl",
          "size": "1.75rem"
        },
        {
          "name": "3XL",
          "slug": "3xl",
          "size": "2.4rem"
        },
        {
          "name": "4XL",
          "slug": "4xl",
          "size": "3.4rem"
        }
      ],
      "lineHeight": true
    },
    "border": {
      "customRadius": true,
      "customWidth": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--vaporous-white)",
      "text": "var(--wp--preset--color--eerie-black)"
    },
    "spacing": {
      "blockGap": "1.35rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--plex)",
      "fontSize": "1rem",
      "fontWeight": "400",
      "lineHeight": "1.58"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--plex)",
          "fontWeight": "700",
          "lineHeight": "1.12"
        },
        "color": {
          "text": "var(--wp--preset--color--eerie-black)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2.2rem, 4vw, 3.9rem)",
          "fontWeight": "700",
          "lineHeight": "1.03"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.75rem, 3vw, 2.7rem)",
          "fontWeight": "700",
          "lineHeight": "1.06"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.35rem, 2vw, 1.85rem)",
          "fontWeight": "600",
          "lineHeight": "1.1"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "clamp(1.12rem, 1.5vw, 1.45rem)",
          "fontWeight": "600",
          "lineHeight": "1.16"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "1rem",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "0.95rem",
          "fontWeight": "600",
          "lineHeight": "1.25"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--scarlet-red)"
        }
      },
      "button": {
        "border": {
          "radius": "0px"
        },
        "color": {
          "background": "var(--wp--preset--color--scarlet-red)",
          "text": "var(--wp--preset--color--vaporous-white)"
        },
        "spacing": {
          "padding": {
            "top": "0.65rem",
            "right": "1.05rem",
            "bottom": "0.65rem",
            "left": "0.9rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--plex)",
          "fontWeight": "600",
          "fontSize": "0.95rem",
          "lineHeight": "1.05"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontWeight": "700"
        }
      },
      "core/post-title": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.08"
        }
      },
      "core/paragraph": {
        "typography": {
          "fontWeight": "400",
          "lineHeight": "1.58"
        }
      },
      "core/list": {
        "typography": {
          "fontWeight": "400",
          "lineHeight": "1.58"
        }
      },
      "core/quote": {
        "typography": {
          "fontWeight": "400",
          "lineHeight": "1.5"
        },
        "border": {
          "left": {
            "color": "var(--wp--preset--color--scarlet-red)",
            "width": "4px"
          }
        },
        "spacing": {
          "padding": {
            "left": "1rem"
          }
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--wp--preset--color--cerebral-grey)"
        }
      },
      "core/group": {
        "spacing": {
          "blockGap": "1.35rem"
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "1.35rem"
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "0.75rem"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "hero-page",
      "title": "Hero Page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "front-page-test",
      "title": "Front Page Test (Default Layout)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
