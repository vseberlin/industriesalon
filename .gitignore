# Ignore everything by default.
/*
/.*

# Keep this ignore file.
!.gitignore
!/*.md
!/package.json
!/package-lock.json
!/composer.json
!/composer.lock
!/.stylelintrc.json
!/eslint.config.js
!/.wp-env.json
!/docker-compose.yml
!/docker/
/docker/*
!/docker/php/
/docker/php/*
!/playwright.config.js
!/.yamllint.yml
!/phpcs.xml.dist
!/phpstan.neon.dist
!/tools/
/tools/*
!/tools/*.sh
!/tools/phpstan-bootstrap.php
/tools/composer-setup.php
/tools/composer.phar
!/ops/
/ops/*
!/ops/import-db-stage.sh
!/ops/sql/
/ops/sql/*
!/ops/sql/*.md
!/ops/migrations/
/ops/migrations/*
!/ops/migrations/*.php
!/ops/migrations/*.md
# Deployment data and media travel privately, never through GitHub.
/ops/uploads/
!/docs/
/docs/*
!/docs/*.md
!/docs/agent/
!/docs/agent/*.md
!/docs/architecture/
!/docs/architecture/*.md
!/docs/infrastructure/
!/docs/infrastructure/*.md
!/docs/project/
!/docs/project/*.md
!/docs/runbooks/
!/docs/runbooks/*.md
!/skills/
/skills/*
!/skills/*/
!/skills/*/SKILL.md
!/tests/
/tests/*
!/tests/e2e/
!/tests/e2e/**
!/themes/
/themes/*
!/themes/industriesalon/
!/themes/industriesalon/**
/themes/industriesalon/assets/maps/qa/

# Keep all plugins.
!/plugins/
!/plugins/**

# Ignore editor lock noise.
*~lock*
__pycache__/
*.pyc
