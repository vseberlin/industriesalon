{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "iss-register/register-app",
  "title": "Schöneweide Register",
  "category": "widgets",
  "icon": "location-alt",
  "description": "Komplettes Schöneweide Register als dynamischer Block.",
  "textdomain": "iss-register",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "attributes": {
    "defaultView": {
      "type": "string",
      "default": "discover"
    },
    "showIntro": {
      "type": "boolean",
      "default": true
    },
    "showFeedback": {
      "type": "boolean",
      "default": true
    },
    "enableExport": {
      "type": "boolean",
      "default": true
    },
    "limitArea": {
      "type": "string",
      "default": ""
    },
    "limitStatus": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  }
}
