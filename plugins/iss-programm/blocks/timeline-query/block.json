{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "industriesalon/timeline-query",
  "title": "Timeline Query",
  "category": "widgets",
  "icon": "filter",
  "description": "Server-rendered filterable timeline with per-instance visible filters.",
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "title": { "type": "string", "default": "" },
    "intro": { "type": "string", "default": "" },
    "limit": { "type": "number", "default": 12 },
    "group": { "type": "string", "default": "" },
    "showMeta": { "type": "boolean", "default": true },
    "timeMode": { "type": "string", "default": "upcoming" },
    "includeRunningRanges": { "type": "boolean", "default": false },
    "allowedTimeModesList": { "type": "array", "default": ["upcoming", "month", "past", "all"] },
    "defaultType": { "type": "string", "default": "all" },
    "presetItemTypesList": { "type": "array", "default": [] },
    "defaultMonth": { "type": "string", "default": "" },
    "allowedTypesList": { "type": "array", "default": ["fuehrungen", "veranstaltungen"] },
    "postTypesList": { "type": "array", "default": [] },
    "taxonomyPresetRules": { "type": "array", "default": [] },
    "taxonomyUiRules": { "type": "array", "default": [] },
    "presetButtons": { "type": "array", "default": [] },
    "showTimeModeFilter": { "type": "boolean", "default": false },
    "showItemTypeFilter": { "type": "boolean", "default": true },
    "showTypeFilter": { "type": "boolean", "default": true },
    "showPostTypeFilter": { "type": "boolean", "default": false },
    "showMonthFilter": { "type": "boolean", "default": false },
    "showCalendarBridge": { "type": "boolean", "default": false },
    "renderMode": { "type": "string", "default": "timeline" },
    "yearGrouping": { "type": "boolean", "default": false },
    "groupRecurringTours": { "type": "boolean", "default": false },
    "showDetailsButton": { "type": "boolean", "default": true },
    "showRecommendButton": { "type": "boolean", "default": true },
    "showTicketsButton": { "type": "boolean", "default": true },
    "showLoadMore": { "type": "boolean", "default": false },
    "showBottomButton": { "type": "boolean", "default": false },
    "loadMoreText": { "type": "string", "default": "" },
    "bottomButtonText": { "type": "string", "default": "" },
    "bottomButtonUrl": { "type": "string", "default": "" },
    "detailsButtonText": { "type": "string", "default": "" },
    "recommendButtonText": { "type": "string", "default": "" },
    "ticketsButtonText": { "type": "string", "default": "" },
    "detailsButtonUrl": { "type": "string", "default": "" },
    "recommendButtonUrl": { "type": "string", "default": "" },
    "ticketsButtonUrl": { "type": "string", "default": "" }
  },
  "editorScript": "file:./index.js"
}
