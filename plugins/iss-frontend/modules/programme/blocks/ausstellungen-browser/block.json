{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "industriesalon/ausstellungen-browser",
  "title": "Ausstellungen Browser",
  "category": "widgets",
  "icon": "visibility",
  "description": "Server-rendered exhibition availability browser, separate from programme occurrences.",
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "title": { "type": "string", "default": "" },
    "limit": { "type": "number", "default": 6 },
    "defaultFilter": { "type": "string", "default": "aktuell" },
    "showFilters": { "type": "boolean", "default": true },
    "showSearch": { "type": "boolean", "default": true },
    "showMeta": { "type": "boolean", "default": true },
    "showSummary": { "type": "boolean", "default": true },
    "detailsButtonText": { "type": "string", "default": "Mehr" }
  },
  "editorScript": "file:./index.js"
}
