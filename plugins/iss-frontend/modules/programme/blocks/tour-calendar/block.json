{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "iss/tour-calendar",
  "title": "Tour Calendar (Interactive)",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "Server-rendered dates with native booking and inquiry controls.",
  "editorScript": "file:./index.js",
  "viewScriptModule": "iss/booking",
  "supports": {
    "html": false,
    "interactivity": true
  },
  "attributes": {
    "tag": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": "Termine wählen"
    },
    "bookingUrl": {
      "type": "string",
      "default": ""
    }
  }
}
