{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "iss/project-status",
  "title": "Project Status",
  "category": "widgets",
  "icon": "calendar",
  "description": "Computed project status from project dates with taxonomy and period fallback.",
  "supports": {
    "html": false
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "editorScript": "file:./index.js",
  "attributes": {
    "showLabel": {
      "type": "boolean",
      "default": false
    }
  }
}
