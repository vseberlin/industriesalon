  "core": null,
  "phpVersion": "8.2",
  "port": 8888,
  "testsEnvironment": false,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_DISPLAY": false,
    "WP_DEBUG_LOG": true,
    "SCRIPT_DEBUG": true
  },
  "plugins": [
    "./plugins/industriesalon-notices",
    "./plugins/industriesalon-schoeneweide-register",
    "./plugins/industriesalon-steuerung",
    "./plugins/iss-content",
    "./plugins/iss-core",
    "./plugins/iss-frontend",
    "./plugins/iss-graph",
    "./plugins/iss-media-control",
    "./plugins/iss-newsletter",
    "./plugins/iss-occurrences",
    "./plugins/iss-commerce-lite",
    "./plugins/iss-publications",
    "./plugins/iss-relations",
    "./plugins/iss-archive",
    "./plugins/query-monitor"
